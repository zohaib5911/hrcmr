# =============================================================================
# .env.example: variable NAMES only. There are no values in this file, ever.
#
#   - Local development:  cp .env.example .env   then fill in TEST values in your editor.
#   - Staging/production: set values in the Railway dashboard (Project > Environment >
#                         Service > Variables). Never in a file, never in chat.
#   - [PUBLIC] is safe to show in a browser. [SECRET] must never be exposed or committed.
#   - Empty means "not set". Local defaults live in the code, not here.
#
# Source of truth: deployment-requirements.txt section 4. A test keeps both in step.
# Generate secrets yourself with the commands in deployment-requirements.txt section 3.
# CI-only secrets (RAILWAY_TOKEN_STAGING, RAILWAY_TOKEN_PRODUCTION, SENTRY_AUTH_TOKEN)
# live in GitHub Actions secrets and do NOT belong in this file.
# =============================================================================

# ---- 4.1 Shared by the api AND worker services -------------------------------

# [PUBLIC] staging | production
APP_ENV=
# [PUBLIC] yourdomain (staging: staging.yourdomain)
DOMAIN=
# [PUBLIC] https://yourdomain
WEB_ORIGIN=
# [PUBLIC] https://admin.yourdomain
ADMIN_ORIGIN=
# [PUBLIC] https://api.yourdomain
API_ORIGIN=

# [SECRET] Postgres URL for the runtime user app_user (private network URL)
DATABASE_URL=
# [SECRET] Postgres URL for the owner user, used by migrations only
DATABASE_URL_OWNER=
# [SECRET] password for app_user
DATABASE_APP_USER_PASSWORD=
# [SECRET] Redis private URL
REDIS_URL=

# [SECRET] session signing secret
SESSION_SECRET=
# [PUBLIC] cookie name shared by api and web
SESSION_COOKIE_NAME=
# [SECRET] JSON map of key id to base64 key
FIELD_ENCRYPTION_KEYS=
# [PUBLIC] key id used for new encryptions
FIELD_ENCRYPTION_ACTIVE_KID=
# [SECRET] HMAC key for blind indexes
BLIND_INDEX_KEY=

# [PUBLIC] Cloudflare account id
R2_ACCOUNT_ID=
# [PUBLIC] S3 endpoint (locally: the MinIO URL)
R2_ENDPOINT=
# [SECRET] R2 token scoped to the files bucket only
R2_ACCESS_KEY_ID=
# [SECRET]
R2_SECRET_ACCESS_KEY=
# [PUBLIC] files bucket name
R2_BUCKET_FILES=
# [SECRET] separate R2 token scoped to the backups bucket only
R2_BACKUP_ACCESS_KEY_ID=
# [SECRET]
R2_BACKUP_SECRET_ACCESS_KEY=
# [PUBLIC] backups bucket name
R2_BUCKET_BACKUPS=
# [PUBLIC] age public key (age1...) used to encrypt database backups
BACKUP_AGE_PUBLIC_KEY=

# [SECRET] Resend sending-access key for one domain
RESEND_API_KEY=
# [PUBLIC] Brand <no-reply@yourdomain>
EMAIL_FROM=
# [PUBLIC] support address used as Reply-To
EMAIL_REPLY_TO=
# [PUBLIC] support address shown to users
SUPPORT_EMAIL=
# [PUBLIC] local development only: where Mailpit listens (used when RESEND_API_KEY is empty)
SMTP_HOST=
SMTP_PORT=

# [SECRET] Anthropic Console key
ANTHROPIC_API_KEY=
# [PUBLIC] main model id
ANTHROPIC_MODEL_MAIN=
# [PUBLIC] fast model id
ANTHROPIC_MODEL_FAST=

# [SECRET] Stripe RESTRICTED key (rk_test_... or rk_live_...)
STRIPE_SECRET_KEY=
# [SECRET] signing secret of the webhook endpoint (whsec_...)
STRIPE_WEBHOOK_SECRET=
# [PUBLIC] price id, GBP annual recurring
STRIPE_PRICE_ANNUAL=
# [PUBLIC] price id, GBP ten-year one-time
STRIPE_PRICE_TEN_YEAR=

# [SECRET] Cloudflare Turnstile secret key
TURNSTILE_SECRET_KEY=
# [SECRET] optional, Companies House REST API key
COMPANIES_HOUSE_API_KEY=
# [SECRET] Sentry DSN of the api project (kept out of the repo)
SENTRY_DSN_API=

# [PUBLIC] ClamAV host (private network)
CLAMAV_HOST=
# [PUBLIC] ClamAV port
CLAMAV_PORT=
# [PUBLIC] optional, comma-separated IPs/CIDRs allowed to reach the super-admin
ADMIN_IP_ALLOWLIST=
# [PUBLIC] check passwords against Have I Been Pwned
HIBP_ENABLED=
# [PUBLIC] master switch for AI features
AI_FEATURES_ENABLED=
# [PUBLIC] Europe/London
TZ=

# ---- 4.2 web service (Next.js) -----------------------------------------------
# Browser-visible. ONLY these NEXT_PUBLIC_ names are allowed; the build fails on any
# other (scripts/check-public-env.mjs). All are non-secret.

# [PUBLIC] https://yourdomain
NEXT_PUBLIC_SITE_URL=
# [PUBLIC] https://api.yourdomain/api/v1
NEXT_PUBLIC_API_URL=
# [PUBLIC] https://admin.yourdomain
NEXT_PUBLIC_ADMIN_URL=
# [PUBLIC] Turnstile SITE key
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# [PUBLIC] Sentry DSN of the web project
NEXT_PUBLIC_SENTRY_DSN_WEB=
# [PUBLIC] optional, Stripe PUBLISHABLE key (pk_...), only if needed
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# [PUBLIC] optional, consent-gated
NEXT_PUBLIC_META_PIXEL_ID=
# [PUBLIC] optional, consent-gated
NEXT_PUBLIC_REDDIT_PIXEL_ID=
# [PUBLIC] optional, consent-gated
NEXT_PUBLIC_GOOGLE_ADS_ID=

# Server-only (never sent to the browser). The web service holds NO third-party secrets.
# [PUBLIC] http://api.railway.internal:8000/api/v1 (private network)
API_INTERNAL_URL=
